<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F4EC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión de Tratamientos"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#00569B"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etNombreTratamiento"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Nombre (ej: Limpieza Dental)"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etDuracionTratamiento"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Duración en minutos (ej: 45)"
        android:inputType="number"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnGuardarTratamiento"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="AGREGAR TRATAMIENTO"
        android:backgroundTint="#00569B"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Servicios Actuales:"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTratamientos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"/>

</LinearLayout>