<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="44dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atencion inmediata"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responder urgencia"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Info del paciente y urgencia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_red"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="URGENCIA"
                    android:textColor="@color/color_rechazada"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvNombrePacUrg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paciente"
                    android:textColor="@color/texto_primario"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvFechaPedida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pide: --"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gris_claro"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPCION"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvDescripcionUrg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- SECCION 1: ACEPTAR -->
            <LinearLayout
                android:id="@+id/seccionAceptar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACEPTAR URGENCIA"
                    android:textColor="@color/teal"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="14dp"/>

                <!-- Fecha -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha de atencion"
                    android:textColor="@color/texto_hint"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/tvFechaElegida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No seleccionada"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirFecha"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Elegir"
                        android:textColor="@color/navy"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:strokeColor="@color/navy"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <!-- Hora -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora de atencion"
                    android:textColor="@color/texto_hint"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/tvHoraElegida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No seleccionada"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirHora"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Elegir"
                        android:textColor="@color/navy"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:strokeColor="@color/navy"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <!-- Aviso colision (visible si hay otro paciente en esa hora) -->
                <TextView
                    android:id="@+id/tvAvisoColision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_red"
                    android:padding="10dp"
                    android:text=""
                    android:textColor="@color/color_rechazada"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <!-- Precio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio total (con recargo +20%)"
                    android:textColor="@color/texto_hint"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPrecioUrgencia"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="0.00"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal"/>

                <TextView
                    android:id="@+id/tvPrecioSugerido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/texto_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAceptarUrgencia"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Aceptar urgencia"
                    android:textColor="@color/blanco"
                    android:textStyle="bold"
                    app:backgroundTint="@color/teal"
                    app:cornerRadius="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- SECCION 2: RECHAZAR -->
            <LinearLayout
                android:id="@+id/seccionRechazar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NO PUEDO ATENDERLO"
                    android:textColor="@color/color_rechazada"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Si no puedes atender esta urgencia, el paciente sera notificado para buscar atencion en otra clinica."
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etMotivoRechazo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:background="@drawable/bg_input_smartie"
                    android:padding="12dp"
                    android:hint="Motivo (ej: fuera de horario, no es mi especialidad)"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:layout_marginBottom="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRechazarUrgencia"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Rechazar y notificar"
                    android:textColor="@color/color_rechazada"
                    android:textStyle="bold"
                    app:strokeColor="@color/color_rechazada"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
