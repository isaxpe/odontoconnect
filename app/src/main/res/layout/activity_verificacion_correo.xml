<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="64dp"
            android:paddingHorizontal="20dp">

            <FrameLayout
                android:layout_width="82dp"
                android:layout_height="82dp">
                <View
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_avatar"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@"
                    android:textColor="@color/navy"
                    android:textSize="38sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verifica tu correo"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <TextView
                android:id="@+id/tvCorreoDestino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviamos un correo a tu bandeja"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMO VERIFICAR"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="14dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="12dp">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <View android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_icon_circle_navy"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:text="1"
                            android:textColor="@color/navy" android:textSize="12sp" android:textStyle="bold"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Abre tu correo electronico"
                        android:textColor="@color/texto_primario" android:textSize="13sp"
                        android:layout_marginStart="12dp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="12dp">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <View android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_icon_circle_navy"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:text="2"
                            android:textColor="@color/navy" android:textSize="12sp" android:textStyle="bold"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Haz clic en el enlace de verificacion"
                        android:textColor="@color/texto_primario" android:textSize="13sp"
                        android:layout_marginStart="12dp" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <View android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_btn_outline"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="3"
                            android:textColor="@color/azul_nav"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Vuelve aqui y toca Ya verifique"
                        android:textColor="@color/texto_primario" android:textSize="13sp"
                        android:layout_marginStart="12dp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvEstadoVerificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_blue"
                android:padding="12dp"
                android:text="Esperando verificacion..."
                android:textColor="#3F51B5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvTiempoRestante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="--"
                android:textColor="@color/texto_hint"
                android:textSize="11sp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYaVerifique"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Ya verifique mi correo"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                app:backgroundTint="@color/navy"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="10dp"
                android:stateListAnimator="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReenviarCorreo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Reenviar correo"
                android:textColor="@color/navy"
                android:textStyle="bold"
                app:strokeColor="@color/navy"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
