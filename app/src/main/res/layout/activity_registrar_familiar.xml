<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="44dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo familiar"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar familiar"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completa los datos"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:padding="18dp">

            <!-- Card datos personales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATOS PERSONALES"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etNombreFamiliarReg"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Nombre completo"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textPersonName|textCapWords"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etParentescoFamiliar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Parentesco (hijo, esposa...)"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textCapWords"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/etEdadFamiliar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_smartie"
                        android:paddingHorizontal="14dp"
                        android:hint="Edad"
                        android:textColorHint="@color/texto_hint"
                        android:textColor="@color/texto_primario"
                        android:textSize="13sp"
                        android:inputType="number"/>

                    <EditText
                        android:id="@+id/etFechaNacFamiliar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="2"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_smartie"
                        android:paddingHorizontal="14dp"
                        android:hint="Fecha nac. (DD/MM/AAAA)"
                        android:textColorHint="@color/texto_hint"
                        android:textColor="@color/texto_primario"
                        android:textSize="13sp"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/etTelefonoFamiliar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Telefono"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="phone"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etOcupacionFamiliar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Ocupacion"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textCapWords"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etDireccionFamiliar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Direccion"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textCapSentences"/>
            </LinearLayout>

            <!-- Card datos medicos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACION MEDICA"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etAlergiasFamiliar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:background="@drawable/bg_input_smartie"
                    android:padding="12dp"
                    android:hint="Alergias conocidas"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etTelefonoEmergencia"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Telefono de emergencia"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="phone"/>
            </LinearLayout>

            <!-- Checkboxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <CheckBox
                    android:id="@+id/cbContactoEmergencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Es mi contacto de emergencia"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:buttonTint="@color/navy"
                    android:layout_marginBottom="6dp"/>

                <CheckBox
                    android:id="@+id/cbResponsableLegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Soy responsable legal"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:buttonTint="@color/navy"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnGuardarFamiliar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Guardar familiar"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_navy"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
