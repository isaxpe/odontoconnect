<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel del Doctor"
            android:textColor="#CCE8FF"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dr. Bienvenido"
            android:textColor="@color/blanco"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_stat_blue"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvCitasConfirmadasValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/azul_primario"
                        android:textSize="26sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoy"
                        android:textColor="@color/texto_secundario"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_stat_green"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvPacientesTotalesValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#18a856"
                        android:textSize="26sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pacientes"
                        android:textColor="@color/texto_secundario"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_orange"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvSolicitudesPendientesValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#e07800"
                        android:textSize="26sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendientes"
                        android:textColor="@color/texto_secundario"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Acciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acciones"
                android:textColor="@color/texto_primario"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnCitasHoy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Citas de Hoy"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/gradient_button"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnVerCitas"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Ver Solicitudes"
                android:textColor="@color/azul_primario"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/bg_card_modern"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnConfigurarAgenda"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Configurar Agenda"
                android:textColor="@color/azul_primario"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/bg_card_modern"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnGestionTratamientos"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Gestionar Tratamientos"
                android:textColor="@color/azul_primario"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/bg_card_modern"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Cerrar sesion"
                android:textColor="@color/color_rechazada"
                android:textStyle="bold"
                android:background="@color/surface_red"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/blanco"
        app:itemIconTint="@color/azul_primario"
        app:itemTextColor="@color/azul_primario"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
