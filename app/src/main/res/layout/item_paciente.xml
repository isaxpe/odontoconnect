<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_white"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Avatar circular dorado -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_gold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="P"
            android:textColor="@color/gold"
            android:textSize="17sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvNombrePacienteItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="@color/texto_primario"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvIdPacienteItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID"
            android:textColor="@color/texto_hint"
            android:textSize="11sp"
            android:layout_marginTop="1dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <TextView
                android:id="@+id/tvEstadoPacienteItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_teal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Activo"
                android:textColor="#0F766E"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFaltasPacienteItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 faltas"
                android:textColor="@color/texto_hint"
                android:textSize="10sp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/texto_hint"
        android:textSize="22sp"
        android:textStyle="bold"/>
</LinearLayout>
