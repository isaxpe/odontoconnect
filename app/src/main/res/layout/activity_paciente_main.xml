<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <LinearLayout
        android:id="@+id/headerPaciente"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/azul_primario"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OdontoConnect"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tu salud dental, en tus manos"
            android:textColor="#90CAF9"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Card info paciente -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInfoPaciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="100dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/blanco"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paciente" android:textColor="@color/texto_secundario" android:textSize="12sp"/>
            <TextView android:id="@+id/tvNombrePaciente" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cargando..." android:textColor="@color/texto_primario" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvIdPaciente" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ID: --" android:textColor="@color/texto_secundario" android:textSize="13sp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estado: " android:textColor="@color/texto_secundario" android:textSize="13sp"/>
                <TextView android:id="@+id/tvEstadoPaciente" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="..." android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>

            <TextView android:id="@+id/tvContadorFaltas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Faltas: 0 / 3" android:textColor="@color/texto_secundario" android:textSize="13sp" android:textStyle="bold"/>

            <!-- NUEVO: banner de advertencia de penalización -->
            <TextView
                android:id="@+id/tvAdvertenciaPenalizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFF3CD"
                android:padding="10dp"
                android:text=""
                android:textColor="#856404"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botones -->
    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/cardInfoPaciente">

        <LinearLayout android:id="@+id/btnAbrirAgendar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
            <androidx.cardview.widget.CardView android:layout_width="58dp" android:layout_height="58dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/azul_claro" app:cardElevation="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:src="@android:drawable/ic_menu_add" app:tint="@color/azul_primario"/>
            </androidx.cardview.widget.CardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Agendar" android:textAlignment="center" android:textColor="@color/texto_primario" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btnFamiliares" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
            <androidx.cardview.widget.CardView android:layout_width="58dp" android:layout_height="58dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#F3E5F5" app:cardElevation="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#7B1FA2"/>
            </androidx.cardview.widget.CardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Familiares" android:textAlignment="center" android:textColor="@color/texto_primario" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/btnMisCitas" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="8dp">
            <androidx.cardview.widget.CardView android:layout_width="58dp" android:layout_height="58dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="#E8F5E9" app:cardElevation="2dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp" android:src="@android:drawable/ic_menu_today" app:tint="#2E7D32"/>
            </androidx.cardview.widget.CardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mis Citas" android:textAlignment="center" android:textColor="@color/texto_primario" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Próxima cita -->
    <TextView
        android:id="@+id/tvTituloProximaCita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="Próxima Cita"
        android:textColor="@color/texto_primario"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBotones"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/azul_claro"
        app:layout_constraintTop_toBottomOf="@id/tvTituloProximaCita">

        <TextView
            android:id="@+id/tvDetallesProximaCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="Aún no tienes citas agendadas."
            android:textAlignment="center"
            android:textColor="@color/azul_primario"
            android:textSize="14sp"
            android:textStyle="italic"
            android:lineSpacingMultiplier="1.5"/>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationPaciente"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/azul_primario"
        app:itemIconTint="@color/blanco"
        app:itemTextColor="@color/blanco"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu_paciente"/>

</androidx.constraintlayout.widget.ConstraintLayout>
