<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:orientation="vertical"
            android:paddingTop="44dp"
            android:paddingBottom="20dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvNombreDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvIdDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ID: --"
                android:textColor="#90CAF9"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/tvEstadoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🟢 Activo"
                android:textColor="@color/blanco"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Botones principales — UN solo botón por acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerExpediente"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text=" Expediente"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_navy" android:stateListAnimator="@null"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbrirOdontograma"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text=" Odontograma"
                    android:textSize="13sp"
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <!-- Info médica -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INFO MÉDICA" android:textColor="@color/azul_primario" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teléfono" android:textColor="@color/texto_secundario" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvTelefonoDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/texto_primario" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Correo" android:textColor="@color/texto_secundario" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvCorreoDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/texto_primario" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo de sangre" android:textColor="@color/texto_secundario" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvSangreDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/texto_primario" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alergias" android:textColor="@color/texto_secundario" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvAlergiasDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/texto_primario" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Medicamentos" android:textColor="@color/texto_secundario" android:textSize="11sp"/>
                    <TextView android:id="@+id/tvMedicamentosDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/texto_primario" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Penalizaciones -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENALIZACIONES" android:textColor="@color/azul_primario" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                    <TextView android:id="@+id/tvFaltasDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 faltas" android:textColor="@color/texto_primario" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditarFaltas"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:text="Editar faltas" android:textSize="12sp"
                            android:textColor="@color/azul_primario"
                            app:strokeColor="@color/azul_primario" app:cornerRadius="10dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDesbloquear"
                            android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:text="Desbloquear" android:textSize="12sp"
                            app:backgroundTint="#2E7D32" app:cornerRadius="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Historial citas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORIAL DE CITAS" android:textColor="@color/azul_primario" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tvHistorialCitas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textColor="@color/texto_primario"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.6"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>