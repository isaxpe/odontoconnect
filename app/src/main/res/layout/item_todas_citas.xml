<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Hora grande a la izquierda -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="14dp">
        <TextView
            android:id="@+id/tvHoraTodasCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#1B3A6B"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Linea vertical separadora -->
    <View
        android:layout_width="2dp"
        android:layout_height="40dp"
        android:background="#E5E7EB"
        android:layout_marginEnd="14dp"/>

    <!-- Info a la derecha -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tag URGENTE (visible solo si aplica) -->
        <TextView
            android:id="@+id/tagUrgTodasCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FEE2E2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="URGENCIA"
            android:textColor="#B91C1C"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTratTodasCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tratamiento"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvNombreTodasCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paciente"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvPagoTodasCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            android:textColor="#B71C1C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>
