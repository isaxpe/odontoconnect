<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar navy -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle_navy"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@"
                android:textColor="@color/navy"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNombrePacienteHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvInfoCitaHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnAsistio"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="Asistio"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/teal"
            android:stateListAnimator="@null"
            app:cornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <Button
            android:id="@+id/btnNoAsistio"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="No asistio"
            android:textColor="@color/color_rechazada"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_red"
            android:stateListAnimator="@null"
            app:cornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </LinearLayout>
</LinearLayout>
