<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verificación de Identidad"
            android:textColor="#00569B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Para proteger tu cuenta, responde al menos 4 de las siguientes 5 preguntas correctamente."
            android:textColor="#666666"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

        <!-- Pregunta 1 -->
        <TextView android:id="@+id/tvPregunta1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#333333" android:textStyle="bold" android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etRespuesta1"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Tu respuesta" android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="16dp"/>

        <!-- Pregunta 2 -->
        <TextView android:id="@+id/tvPregunta2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#333333" android:textStyle="bold" android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etRespuesta2"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Tu respuesta" android:inputType="textEmailAddress"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="16dp"/>

        <!-- Pregunta 3 -->
        <TextView android:id="@+id/tvPregunta3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#333333" android:textStyle="bold" android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etRespuesta3"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Tu respuesta" android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="16dp"/>

        <!-- Pregunta 4 -->
        <TextView android:id="@+id/tvPregunta4"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#333333" android:textStyle="bold" android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etRespuesta4"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Tu respuesta" android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="16dp"/>

        <!-- Pregunta 5 -->
        <TextView android:id="@+id/tvPregunta5"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#333333" android:textStyle="bold" android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etRespuesta5"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Tu respuesta" android:inputType="number"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnVerificar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VERIFICAR IDENTIDAD"
            android:backgroundTint="#00569B"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
