<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvInfoCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Info de la cita"
        android:textColor="@color/texto_primario"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvTriajeCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Triaje"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvEstadoPagoCita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_teal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Pago recibido"
        android:textColor="#0F766E"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnAceptar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="Aceptar"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_navy"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnRechazar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="Rechazar"
            android:textColor="@color/color_rechazada"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_red"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVerComprobante"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Ver comprobante"
        android:textColor="@color/navy"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_gold"
        android:stateListAnimator="@null"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>
</LinearLayout>
