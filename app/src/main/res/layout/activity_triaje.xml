<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="44dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Triaje medico"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Como te sientes?"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/bannerUrgencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_red"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp">
                <TextView
                    android:id="@+id/tvMensajeUrgencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgencia detectada"
                    android:textColor="@color/color_rechazada"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIVEL DE DOLOR"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/rgDolor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="Sin dolor"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="Molestia leve"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="Dolor moderado"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="Dolor fuerte"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp"/>

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="Dolor insoportable"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIPO DE VISITA"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/rgVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Primera vez"
                    android:textColor="@color/texto_primario"
                    android:textSize="12sp"/>

                <RadioButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Revision"
                    android:textColor="@color/texto_primario"
                    android:textSize="12sp"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOMAS MEDICAMENTOS?"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/rgMedicamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbMedicamentosSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Si"
                    android:textColor="@color/texto_primario"
                    android:textSize="12sp"/>

                <RadioButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:button="@null"
                    android:background="@drawable/bg_radio_option"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="No"
                    android:textColor="@color/texto_primario"
                    android:textSize="12sp"/>
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutDetalleMedicamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etMedicamentosDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:background="@drawable/bg_input_smartie"
                    android:padding="12dp"
                    android:hint="Cuales medicamentos?"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textMultiLine|textCapSentences"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIBE TU MOLESTIA"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etDescripcionMolestia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:background="@drawable/bg_input_smartie"
                android:padding="14dp"
                android:hint="Describe con detalle lo que sientes"
                android:textColorHint="@color/texto_hint"
                android:textColor="@color/texto_primario"
                android:textSize="13sp"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTRA INFORMACION"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etOtraInformacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:background="@drawable/bg_input_smartie"
                android:padding="14dp"
                android:hint="Alergias, embarazo, etc. (opcional)"
                android:textColorHint="@color/texto_hint"
                android:textColor="@color/texto_primario"
                android:textSize="13sp"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOTO (OPCIONAL)"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <ImageView
                android:id="@+id/ivFotoMolestia"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/fondo_input"
                android:scaleType="fitCenter"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvFotoSeleccionada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin foto"
                android:textColor="@color/texto_hint"
                android:textSize="11sp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeleccionarFoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Seleccionar foto"
                android:textColor="@color/navy"
                android:textStyle="bold"
                app:strokeColor="@color/navy"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="18dp"
                android:stateListAnimator="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarTriaje"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Enviar triaje"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                app:backgroundTint="@color/navy"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
