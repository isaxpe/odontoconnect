<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Odontoconnect" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy_dark</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="android:windowBackground">@color/fondo_app</item>
        <item name="android:statusBarColor">@color/navy_dark</item>
        <item name="android:navigationBarColor">@color/blanco</item>
        <item name="materialButtonStyle">@style/BotonNavy</item>
        <item name="materialCardViewStyle">@style/CardSmartie</item>
        <item name="android:windowAnimationStyle">@style/TransicionSuave</item>
    </style>

    <style name="BotonNavy" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BotonGold" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/navy</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BotonOutlineAzul" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/navy</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="CardSmartie" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/fondo_card</item>
        <item name="strokeColor">@color/gris_claro</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="InputSmartie" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/navy</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/navy</item>
        <item name="boxBackgroundColor">@color/fondo_input</item>
    </style>

    <!-- Compatibilidad -->
    <style name="InputModerno" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/navy</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/navy</item>
        <item name="boxBackgroundColor">@color/fondo_input</item>
    </style>

    <style name="BotonAzul" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="HoraBtn" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:backgroundTint">@color/navy_light</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="TransicionSuave" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
