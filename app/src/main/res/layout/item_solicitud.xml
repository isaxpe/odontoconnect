<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Tag URGENTE (visible solo si la cita es urgente) -->
    <TextView
        android:id="@+id/tagUrgente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_red"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="URGENTE +20%"
        android:textColor="@color/color_rechazada"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvInfoCita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cita"
        android:textColor="@color/texto_primario"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"/>

    <TextView
        android:id="@+id/tvTriajeCita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="1dp"/>

    <TextView
        android:id="@+id/tvEstadoPagoCita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_gold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text=""
        android:textColor="#92400E"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerComprobante"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Ver comprobante"
            android:textColor="@color/navy"
            android:textSize="12sp"
            android:textStyle="bold"
            app:strokeColor="@color/navy"
            app:strokeWidth="1.5dp"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnRechazar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="Rechazar"
            android:textColor="@color/color_rechazada"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/surface_red"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnAceptar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="Aceptar"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_navy"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
