<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerAgendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/azul_primario"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTituloAgendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agendar Cita"
            android:textColor="@color/blanco"
            android:textSize="22sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Selecciona tratamiento, día y horario"
            android:textColor="#90CAF9"
            android:textSize="13sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerAgendar"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Paso 1: Tratamiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="1. Selecciona el tratamiento:"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerTratamiento"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_spinner"
                android:paddingHorizontal="12dp" />

            <!-- Paso 2: Calendario personalizado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="2. Selecciona el día:"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Leyenda de colores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="#1565C0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:text="Disponible"
                    android:textColor="@color/texto_secundario"
                    android:textSize="11sp" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:text="Sin agenda"
                    android:textColor="@color/texto_secundario"
                    android:textSize="11sp" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="#2E7D32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionado"
                    android:textColor="@color/texto_secundario"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Contenedor del calendario personalizado -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Navegación mes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <android.widget.ImageButton
                            android:id="@+id/btnMesAnterior"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Mes anterior"
                            android:src="@android:drawable/ic_media_previous" />

                        <TextView
                            android:id="@+id/tvMesActual"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Abril 2026"
                            android:textColor="@color/texto_primario"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <android.widget.ImageButton
                            android:id="@+id/btnMesSiguiente"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Mes siguiente"
                            android:src="@android:drawable/ic_media_next" />
                    </LinearLayout>

                    <!-- Días de la semana -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:columnCount="7">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Do"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Lu"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Ma"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Mi"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Ju"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Vi"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:text="Sá"
                            android:textColor="#999"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </GridLayout>

                    <!-- Grid de días (se llena dinámicamente desde Java) -->
                    <GridLayout
                        android:id="@+id/gridCalendario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Info disponibilidad -->
            <TextView
                android:id="@+id/tvInfoDisponibilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Selecciona un día en el calendario."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- Paso 3: Horarios -->
            <LinearLayout
                android:id="@+id/layoutHoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="3. Selecciona el horario:"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerHoras"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Botón confirmar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarCita"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="20dp"
                android:text="CONFIRMAR CITA"
                android:textSize="15sp"
                app:backgroundTint="@color/azul_primario"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
