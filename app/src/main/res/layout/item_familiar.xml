<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/gris_claro"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/azul_claro" app:cardElevation="0dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/azul_primario"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="12dp">
            <TextView android:id="@+id/tvNombreFamiliar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nombre" android:textColor="@color/texto_primario" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvParentescoFamiliar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Parentesco" android:textColor="@color/texto_secundario" android:textSize="13sp"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgendarFamiliar"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="Agendar" android:background="@drawable/gradient_button" android:stateListAnimator="@null" app:cornerRadius="10dp"
            android:textSize="12sp" android:paddingHorizontal="12dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
