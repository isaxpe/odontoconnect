<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTratHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tratamiento"
            android:textColor="@color/texto_primario"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvEstadoHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_teal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Completada"
            android:textColor="#0F766E"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFechaHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha - Hora"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>
</LinearLayout>
