<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AgendaActivity">

    <LinearLayout
        android:id="@+id/headerAgendaLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00569B"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Gestión de Agenda - Dr. López"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <CalendarView
        android:id="@+id/calendarViewAgenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F4EC"
        app:layout_constraintTop_toBottomOf="@id/headerAgendaLayout" />

    <LinearLayout
        android:id="@+id/layoutControlDia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/calendarViewAgenda">

        <TextView
            android:id="@+id/tvFechaSeleccionada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Selecciona una fecha"
            android:textColor="#00569B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchDiaDisponible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Día Laboral  "
            android:textColor="#000000"
            android:checked="false" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutControlDia"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationAgenda">

        <LinearLayout
            android:id="@+id/layoutHorariosConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona los horarios disponibles para citas:"
                android:textColor="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <CheckBox android:id="@+id/chk9am" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="09:00 AM - 10:00 AM" android:textSize="16sp" android:padding="8dp"/>
            <CheckBox android:id="@+id/chk10am" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="10:00 AM - 11:00 AM" android:textSize="16sp" android:padding="8dp"/>
            <CheckBox android:id="@+id/chk11am" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="11:00 AM - 12:00 PM" android:textSize="16sp" android:padding="8dp"/>
            <CheckBox android:id="@+id/chk12pm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="12:00 PM - 01:00 PM" android:textSize="16sp" android:padding="8dp"/>
            <CheckBox android:id="@+id/chk1pm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01:00 PM - 02:00 PM" android:textSize="16sp" android:padding="8dp"/>
            <CheckBox android:id="@+id/chk4pm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="04:00 PM - 05:00 PM" android:textSize="16sp" android:padding="8dp"/>
            <CheckBox android:id="@+id/chk5pm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="05:00 PM - 06:00 PM" android:textSize="16sp" android:padding="8dp"/>

            <Button
                android:id="@+id/btnGuardarHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#2E7D32"
                android:text="Guardar Disponibilidad"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationAgenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00569B"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>