<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Familiar"
            android:textColor="#00569B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Llena los datos del familiar. Nombre, parentesco y teléfono son obligatorios."
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Sección: Datos básicos -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DATOS BÁSICOS" android:textColor="#00569B"
            android:textSize="12sp" android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etNombreFamiliarReg"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Nombre completo *"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etFechaNacFamiliar"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Fecha de nacimiento (dd/mm/yyyy)"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etParentescoFamiliar"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Parentesco (madre, padre, hijo/a, esposo/a...) *"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etEdadFamiliar"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Edad"
            android:inputType="number"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="20dp"/>

        <!-- Sección: Contacto -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="INFORMACIÓN DE CONTACTO" android:textColor="#00569B"
            android:textSize="12sp" android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etTelefonoFamiliar"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Número de teléfono *"
            android:inputType="phone"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etTelefonoEmergencia"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Teléfono alternativo de emergencia"
            android:inputType="phone"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etDireccionFamiliar"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Dirección"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etOcupacionFamiliar"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:hint="Ocupación"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" android:layout_marginBottom="20dp"/>

        <!-- Sección: Médica -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="INFORMACIÓN MÉDICA" android:textColor="#00569B"
            android:textSize="12sp" android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etAlergiasFamiliar"
            android:layout_width="match_parent" android:layout_height="80dp"
            android:hint="Alergias o condiciones médicas relevantes"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:gravity="top"
            android:layout_marginBottom="20dp"/>

        <!-- Sección: Checkboxes -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RESPONSABILIDAD" android:textColor="#00569B"
            android:textSize="12sp" android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <CheckBox android:id="@+id/cbResponsableLegal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="¿Es el responsable legal del paciente?"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <CheckBox android:id="@+id/cbContactoEmergencia"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="¿Es el contacto de emergencia principal?"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnGuardarFamiliar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GUARDAR FAMILIAR"
            android:backgroundTint="#00569B"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
