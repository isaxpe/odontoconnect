<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/gris_claro"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Info de la cita -->
        <TextView
            android:id="@+id/tvInfoCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cita"
            android:textColor="@color/texto_primario"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.5"/>

        <!-- Triaje del paciente -->
        <TextView
            android:id="@+id/tvTriajeCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EEF6FF"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/texto_primario"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"
            android:visibility="gone"/>

        <!-- Estado del pago -->
        <TextView
            android:id="@+id/tvEstadoPagoCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF8E1"
            android:padding="10dp"
            android:text=""
            android:textColor="#F57C00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- Botón ver comprobante (solo visible si el paciente envió) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerComprobante"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="📄  Ver comprobante de pago"
            android:textSize="13sp"
            android:textColor="@color/azul_primario"
            android:visibility="gone"
            app:strokeColor="@color/azul_primario"
            app:cornerRadius="10dp"/>

        <!-- Botones aceptar/rechazar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Rechazar"
                android:textColor="@color/color_rechazada"
                app:strokeColor="@color/color_rechazada"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Aceptar"
                app:backgroundTint="@color/azul_primario"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
