<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="44dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atencion prioritaria"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitar urgencia"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pide atencion fuera del horario normal"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Banner de aviso +20% -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_gold"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVISO DE COSTO"
                    android:textColor="#92400E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Las citas de urgencia tienen un recargo del 20% por atencion prioritaria. El doctor revisara tu solicitud y te respondera."
                    android:textColor="#92400E"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- Descripcion -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUE TE SUCEDE?"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDescripcionUrgencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:background="@drawable/bg_input_smartie"
                android:padding="14dp"
                android:hint="Describe tu dolor, sintomas, cuanto tiempo llevas asi..."
                android:textColorHint="@color/texto_hint"
                android:textColor="@color/texto_primario"
                android:textSize="13sp"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:layout_marginBottom="18dp"/>

            <!-- Fecha preferida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FECHA PREFERIDA"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvFechaPreferida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No seleccionada"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeleccionarFecha"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Elegir"
                    android:textColor="@color/navy"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/navy"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Hora preferida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORA PREFERIDA"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvHoraPreferida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No seleccionada"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeleccionarHora"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Elegir"
                    android:textColor="@color/navy"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/navy"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:padding="12dp"
                android:text="El doctor puede proponerte una fecha/hora diferente segun su disponibilidad. Recibiras una notificacion con su respuesta."
                android:textColor="@color/navy"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarSolicitud"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Enviar solicitud de urgencia"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                app:backgroundTint="@color/color_rechazada"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="10dp"
                android:stateListAnimator="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Cancelar"
                android:textColor="@color/navy"
                android:textStyle="bold"
                app:strokeColor="@color/navy"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
