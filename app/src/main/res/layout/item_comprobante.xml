<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/tvTratComp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tratamiento" android:textColor="@color/texto_primario" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvPacienteComp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="👤 --" android:textColor="@color/texto_secundario" android:textSize="14sp"/>
        <TextView android:id="@+id/tvFechaComp2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="📅 --" android:textColor="@color/texto_secundario" android:textSize="13sp"/>
        <TextView android:id="@+id/tvMontoComp2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="💲 --" android:textColor="@color/azul_primario" android:textSize="14sp" android:textStyle="bold"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerComp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Ver comprobante"
            android:background="@drawable/bg_btn_navy" android:stateListAnimator="@null"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
