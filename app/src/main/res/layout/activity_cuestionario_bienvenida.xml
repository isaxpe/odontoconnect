<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="44dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completa tu perfil"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvSubtituloBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ayudanos a brindarte la mejor atencion"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:padding="18dp">

            <!-- Datos personales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATOS PERSONALES"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etFechaNacBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Fecha de nacimiento (DD/MM/AAAA)"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etTelefonoBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Telefono"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="phone"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etTipoSangreBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Tipo de sangre (O+, A-...)"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textCapCharacters"/>
            </LinearLayout>

            <!-- Informacion medica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACION MEDICA"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etAlergiasBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:background="@drawable/bg_input_smartie"
                    android:padding="12dp"
                    android:hint="Alergias conocidas"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etMedicamentosBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:background="@drawable/bg_input_smartie"
                    android:padding="12dp"
                    android:hint="Medicamentos actuales"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etEnfermedadesBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:background="@drawable/bg_input_smartie"
                    android:padding="12dp"
                    android:hint="Enfermedades cronicas"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"/>
            </LinearLayout>

            <!-- Emergencia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTACTO DE EMERGENCIA"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etContactoEmergenciaBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_smartie"
                    android:paddingHorizontal="14dp"
                    android:hint="Nombre y telefono"
                    android:textColorHint="@color/texto_hint"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:inputType="textCapWords"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnGuardarBienvenida"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Guardar y continuar"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_navy"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnOmitirBienvenida"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Omitir por ahora"
                android:textColor="@color/texto_secundario"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
