<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerMisCitas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis Citas"
            android:textColor="@color/blanco"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- E: Banner de pago pendiente -->
    <TextView
        android:id="@+id/tvBannerPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFF3CD"
        android:padding="14dp"
        android:text=""
        android:textColor="#856404"
        android:textSize="13sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.3"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerMisCitas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mensaje vacío -->
    <TextView
        android:id="@+id/tvMensajeVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No tienes citas registradas todavía."
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvBannerPago"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Lista -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvBannerPago"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationPaciente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedorMisCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- BottomNavigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationPaciente"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/gradient_header"
        app:itemIconTint="@color/blanco"
        app:itemTextColor="@color/blanco"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu_paciente"/>

</androidx.constraintlayout.widget.ConstraintLayout>
