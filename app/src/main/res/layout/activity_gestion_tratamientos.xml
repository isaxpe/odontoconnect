<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <FrameLayout
        android:id="@+id/headerTratamientos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="44dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catalogo"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tratamientos"
                android:textColor="@color/blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestiona tus servicios"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_wave_bottom"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerTratamientos"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:padding="18dp">

            <!-- Form nuevo tratamiento -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.1"
                    android:text="NUEVO TRATAMIENTO"
                    android:textColor="@color/texto_hint"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNombreTrat"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_input_smartie"
                    android:hint="Nombre del tratamiento"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_primario"
                    android:textColorHint="@color/texto_hint"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etHorasTrat"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_smartie"
                        android:hint="Horas"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/texto_primario"
                        android:textColorHint="@color/texto_hint"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etMinutosTrat"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_smartie"
                        android:hint="Minutos"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/texto_primario"
                        android:textColorHint="@color/texto_hint"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPrecioTrat"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_smartie"
                    android:hint="Precio ($)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/texto_primario"
                    android:textColorHint="@color/texto_hint"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnAgregarTratamiento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_gold"
                    android:stateListAnimator="@null"
                    android:text="Agregar tratamiento"
                    android:textColor="@color/azul_muy_claro"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tratamientos activos"
                android:textColor="@color/texto_primario"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvSinTratamientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="No hay tratamientos registrados"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/contenedorTratamientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layoutAnimation="@anim/layout_fall_down"/>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottomnav_doctor_pill"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
