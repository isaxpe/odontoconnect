<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:paddingTop="60dp">

        <!-- Icono de correo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✉️"
            android:textSize="72sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Verifica tu correo"
            android:textColor="@color/texto_primario"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvCorreoDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Enviamos un enlace a tu correo"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="32dp"/>

        <!-- Pasos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Como verificar:"
                    android:textColor="@color/azul_primario"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="1." android:textColor="@color/azul_primario" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Abre tu app de correo" android:textColor="@color/texto_primario" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="2." android:textColor="@color/azul_primario" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Busca el correo de OdontoConnect (revisa spam)" android:textColor="@color/texto_primario" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="3." android:textColor="@color/azul_primario" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toca el enlace de verificacion" android:textColor="@color/texto_primario" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="4." android:textColor="@color/azul_primario" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Regresa aqui y toca el boton de abajo" android:textColor="@color/texto_primario" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Estado -->
        <TextView
            android:id="@+id/tvEstadoVerificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Botón principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYaVerifique"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:text="Ya verifique mi correo"
            android:textSize="15sp"
            app:backgroundTint="@color/azul_primario"
            app:cornerRadius="14dp"/>

        <!-- Reenviar -->
        <TextView
            android:id="@+id/tvTiempoRestante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReenviarCorreo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Reenviar correo"
            android:textColor="@color/azul_primario"
            app:strokeColor="@color/azul_primario"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
