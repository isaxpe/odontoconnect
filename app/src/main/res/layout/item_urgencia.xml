<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FEE2E2"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="URGENCIA"
        android:textColor="#B91C1C"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvNombreUrgencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paciente"
        android:textColor="#1B3A6B"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvFechaHoraUrgencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pide: --"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvDescripcionUrgencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:padding="10dp"
        android:text="Descripcion"
        android:textColor="#92400E"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="10dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResponderUrgencia"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Responder urgencia"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#DC2626"
        app:cornerRadius="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginTop="12dp"
        android:stateListAnimator="@null"/>
</LinearLayout>
